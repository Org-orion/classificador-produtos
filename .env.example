# Configuração do Supabase (frontend) — copie para .env e preencha.
# Apenas chaves PÚBLICAS entram aqui. Segredos (service_role, SESSION_JWT_SECRET)
# NUNCA vão para .env do frontend nem para o bundle — ficam em Supabase Secrets.

# URL do projeto Supabase (ex.: https://<ref>.supabase.co)
VITE_SUPABASE_URL=""

# Chave publicável / anon (pública por design; protegida por RLS no banco)
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Ref/ID do projeto Supabase
VITE_SUPABASE_PROJECT_ID=""
